CLAUDE_SEO_WEB_DATA=/data
CLAUDE_SEO_WEB_AUTO_WORKER=0
CLAUDE_SEO_WEB_FAKE_RUNS=0
CLAUDE_SEO_WEB_DEV_EMAIL_TOKENS=0
CLAUDE_SEO_WEB_RATE_LIMIT=30
CLAUDE_SEO_WEB_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
CLAUDE_SEO_PUBLIC_URL=http://127.0.0.1:8001
CLAUDE_SEO_WEB_HSTS=0

# Optional SMTP provider. When unset, messages are stored in email_outbox.
# CLAUDE_SEO_SMTP_HOST=smtp.example.com
# CLAUDE_SEO_SMTP_PORT=587
# CLAUDE_SEO_SMTP_USER=
# CLAUDE_SEO_SMTP_PASSWORD=
# CLAUDE_SEO_MAIL_FROM=Claude SEO <noreply@example.com>

# Optional Stripe billing. When unset, checkout returns dev mode and the local
# /api/billing/dev-upgrade endpoint can be used for testing.
# CLAUDE_SEO_STRIPE_SECRET_KEY=sk_live_...
# CLAUDE_SEO_STRIPE_WEBHOOK_SECRET=whsec_...
# CLAUDE_SEO_STRIPE_PRICE_PRO=price_...
# CLAUDE_SEO_STRIPE_PRICE_AGENCY=price_...
# CLAUDE_SEO_BILLING_SUCCESS_URL=https://app.example.com/?billing=success&session_id={CHECKOUT_SESSION_ID}
# CLAUDE_SEO_BILLING_CANCEL_URL=https://app.example.com/?billing=cancelled

# Runtime overrides.
# CLAUDE_SEO_LAUNCHER=/app/bin/claude-seo
# CLAUDE_SEO_PYTHON=/usr/local/bin/python
